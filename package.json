    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.462.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.61.0",
    "sonner": "^1.7.0",
